// ─── Platform: API, billing, audit, notifications ───────────────────

model ApiToken {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  hash        String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Webhook {
  id          String   @id @default(uuid())
  workspaceId String
  url         String
  events      String[]
  secret      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String   @id @default(uuid())
  workspaceId      String   @unique
  stripeCustomerId String?
  stripeSubId      String?
  plan             Plan     @default(free)
  status           String   @default("active")
  periodEnd        DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String?
  action      String
  target      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
