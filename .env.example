# ─────────────────────────────────────────────────────────────────────
# DevNotes — environment template. Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────

# ─── Database (Prisma Postgres) ──────────────────────────────────────
# Direct (pooled) connection string from the Prisma Console.
# Standard postgres:// protocol — Prisma 7 connects via @prisma/adapter-pg
# (see lib/db.ts). Create a database with: npx prisma init --db
DATABASE_URL=

# ─── Auth.js ─────────────────────────────────────────────────────────
# Session encryption secret. Generate with: npx auth secret
AUTH_SECRET=my-note-app-secret

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
